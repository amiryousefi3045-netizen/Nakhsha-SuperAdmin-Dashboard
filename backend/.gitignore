# Backend .gitignore for Nakhsha backend

# Node
node_modules/

# Logs
logs/
*.log

# Environment — never commit real secrets
.env
.env.*
*.env
# Keep the example template in version control
!.env.example

# Runtime / build
dist/
build/

# Uploads / user files (do not commit)
uploads/

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/

# PM2 / process files
pids/
*.pid

