# Backend .gitignore for Nakhsha backend

# Dependencies
node_modules/
**/node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment — never commit real secrets
.env
.env.*
*.env
!.env.example

# Runtime / build
dist/
build/

# Uploads / user files (do not commit)
uploads/
**/uploads/

# Cache and temporary files
.cache/
.tmp/
coverage/

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# PM2 / process files
pids/
*.pid
