# =============================================================
# Nakhsha (نخشا)  Backend Environment Variables
# =============================================================
# 1. Copy this file:  cp .env.example .env   (or: copy .env.example .env on Windows)
# 2. Fill in every value marked with <...>
# 3. NEVER commit .env  it is listed in .gitignore
# =============================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
NODE_ENV=development          # development | production | test
PORT=5000

# ---------------------------------------------------------
# MongoDB - Local Development
# ---------------------------------------------------------
# Ensure MongoDB is running locally as a service before starting the backend.
# Default connection for local development (no authentication):
#   mongodb://127.0.0.1:27017/nakhsha
# 
# With authentication enabled:
#   mongodb://admin:<password>@127.0.0.1:27017/nakhsha?authSource=admin
# 
# For MongoDB Atlas (cloud):
#   mongodb+srv://<user>:<pass>@cluster.mongodb.net/nakhsha
MONGODB_URI=mongodb://127.0.0.1:27017/nakhsha

# Separate URI for automated tests (optional -- falls back to MONGODB_URI)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/nakhsha_test

# ---------------------------------------------------------
# JWT
# ---------------------------------------------------------
# Generate a secure value:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<replace-with-long-random-secret>
JWT_TTL=7d

# ---------------------------------------------------------
# CORS - Local Development
# ---------------------------------------------------------
# Comma-separated list of allowed origins (no trailing slash).
# For local development:
#   - http://localhost:5173 (Vite dev server)
#   - http://localhost:3000 (alternative port)
#   - http://localhost:5000 (backend direct access for testing)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# ---------------------------------------------------------
# MeliPayamak SMS
# ---------------------------------------------------------
SMS_USERNAME=<your-melipayamak-username-or-phone>
SMS_PASSWORD=<your-melipayamak-api-password>
SMS_FROM=<your-melipayamak-sender-line-number>
SMS_TO_FORMAT=09
SMS_TIMEOUT_MS=4000

# Set SMS_MOCK=true in development to skip real SMS calls and print OTP to console
SMS_MOCK=true

# ---------------------------------------------------------
# Index Synchronization
# ---------------------------------------------------------
# When true, Mongoose runs syncIndexes() on every startup — this drops and
# recreates all schema indexes, which can be slow on large collections.
# Leave false (default) in day-to-day operation; enable only on first deploy
# or after a schema change that modifies an index definition.
#
# Equivalent CLI one-shot:  SYNC_INDEXES=true node server.js
SYNC_INDEXES=false

# ---------------------------------------------------------
# Sentry Error Monitoring
# ---------------------------------------------------------
# Leave empty (or unset) to disable monitoring in development.
# For production, obtain DSN from: https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=

# Maps to Sentry's "environment" field. Defaults to NODE_ENV if not set.
# In development: leave as development
# In production: set to production
SENTRY_ENVIRONMENT=development

# Fraction of requests to sample for performance tracing (0.0 – 1.0).
# 0.1 = 10 % of requests. Set to 0 to disable performance monitoring entirely.
# In development: 0 (disabled)
# In production: 0.1 (or adjust as needed)
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------
# OTP
# ---------------------------------------------------------
# Generate a secure value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"}
OTP_SECRET=<replace-with-long-random-secret>
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=8
