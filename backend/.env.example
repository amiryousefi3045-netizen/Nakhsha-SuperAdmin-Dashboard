# =============================================================
# Nakhsha (نخشا)  Backend Environment Variables
# =============================================================
# 1. Copy this file:  cp .env.example .env   (or: copy .env.example .env on Windows)
# 2. Fill in every value marked with <...>
# 3. NEVER commit .env  it is listed in .gitignore
# =============================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
NODE_ENV=development          # development | production | test
PORT=5000

# ---------------------------------------------------------
# MongoDB
# ---------------------------------------------------------
# Local development (no auth):
#   mongodb://127.0.0.1:27017/nakhsha
# Docker Compose (with auth):
#   mongodb://<MONGO_USER>:<MONGO_PASS>@mongodb:27017/nakhsha?authSource=admin
# MongoDB Atlas:
#   mongodb+srv://<user>:<pass>@cluster.mongodb.net/nakhsha
MONGODB_URI=mongodb://127.0.0.1:27017/nakhsha

# Separate URI for automated tests (optional -- falls back to MONGODB_URI)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/nakhsha_test

# ---------------------------------------------------------
# JWT
# ---------------------------------------------------------
# Generate a secure value:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<replace-with-long-random-secret>
JWT_TTL=7d

# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# ---------------------------------------------------------
# MeliPayamak SMS
# ---------------------------------------------------------
SMS_USERNAME=<your-melipayamak-username-or-phone>
SMS_PASSWORD=<your-melipayamak-api-password>
SMS_FROM=<your-melipayamak-sender-line-number>
SMS_TO_FORMAT=09
SMS_TIMEOUT_MS=4000

# Set SMS_MOCK=true in development to skip real SMS calls and print OTP to console
SMS_MOCK=true

# ---------------------------------------------------------
# OTP
# ---------------------------------------------------------
# Generate a secure value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=<replace-with-long-random-secret>
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=8
