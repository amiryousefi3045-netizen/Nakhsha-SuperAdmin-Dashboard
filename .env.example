# =============================================================
# Nakhsha (نخشا)  Root / Docker Compose Environment Variables
# =============================================================
# Used by docker-compose.yml for MongoDB credentials and shared config.
# Backend-specific vars live in backend/.env.example
#
# 1. Copy:    cp .env.example .env
# 2. Fill in every value marked with <...>
# 3. NEVER commit .env  -- it is listed in .gitignore
# =============================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
NODE_ENV=development          # development | production | test

# ---------------------------------------------------------
# MongoDB (Docker Compose credentials)
# ---------------------------------------------------------
MONGO_USERNAME=<your-mongo-admin-username>
MONGO_PASSWORD=<replace-with-strong-password>
MONGO_INITDB_DATABASE=nakhsha

# ---------------------------------------------------------
# Backend
# ---------------------------------------------------------
PORT=5000
# Generate a secure value:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<replace-with-long-random-secret>
JWT_TTL=7d
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info

# OTP
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------
VITE_API_BASE=/api
VITE_SERVER_ORIGIN=http://localhost:5000

# ---------------------------------------------------------
# Port reference
# ---------------------------------------------------------
# Development:
#   Frontend (Vite)  -> 5173
#   Backend (Node)   -> 5000
#   MongoDB          -> 27017
# Docker Production:
#   Frontend (nginx) -> 3000
#   Backend (Node)   -> 5000
#   MongoDB          -> 27018
