# =============================================================
# Nakhsha (نخشا) - Root Environment Variables
# =============================================================
# Local development configuration (no Docker).
# For production deployment, adjust values as needed.
#
# 1. Copy:    cp .env.example .env
# 2. Fill in every value marked with <...>
# 3. NEVER commit .env  -- it is listed in .gitignore
# =============================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
NODE_ENV=development          # development | production | test

# ---------------------------------------------------------
# MongoDB - Local Development
# ---------------------------------------------------------
# For local development with auth:
#   mongodb://admin:<password>@127.0.0.1:27017/nakhsha?authSource=admin
# For local development without auth:
#   mongodb://127.0.0.1:27017/nakhsha
MONGODB_URI=mongodb://127.0.0.1:27017/nakhsha

# ---------------------------------------------------------
# Backend
# ---------------------------------------------------------
PORT=5000

# Generate a secure value:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<replace-with-long-random-secret>
JWT_TTL=7d

# Comma-separated list of allowed origins (for CORS)
# Local development includes: localhost:5173 (Vite), localhost:3000 (alternative), localhost:5000 (backend direct)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

LOG_LEVEL=info

# Index Synchronization  (see backend/.env.example for details)
# Enable on first deploy or after schema changes; leave false otherwise.
SYNC_INDEXES=false

# OTP
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------
# Frontend (Vite) - Local Development
# ---------------------------------------------------------
# For local dev, frontend makes requests to backend via Vite proxy
VITE_API_BASE=/api
VITE_SERVER_ORIGIN=http://localhost:5000

# NOTE: For production deployment, update these to your domain/server URL:
#   VITE_SERVER_ORIGIN=https://your-domain.com (or your server IP:port)
# ---------------------------------------------------------
# Port reference
# ---------------------------------------------------------
# Development:
#   Frontend (Vite)  -> 5173
#   Backend (Node)   -> 5000
#   MongoDB          -> 27017
# Docker Production:
#   Frontend (nginx) -> 3000
#   Backend (Node)   -> 5000
#   MongoDB          -> 27018
