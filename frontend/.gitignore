# Frontend .gitignore for Nakhsha

# Dependencies
node_modules/
**/node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
build/
.vite/
*.local

# Environment — never commit real secrets
.env
.env.*
*.env
!.env.example

# Uploads / generated assets
public/uploads/

# Cache and temporary files
.cache/
.tmp/
coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore system files
Thumbs.db
Desktop.ini
