# Root .gitignore for Nakhsha project

# Dependencies
**/node_modules/
**/.pnp.*

# Build outputs
**/dist/
**/build/
**/out/
**/.next/
**/.turbo/
**/.vite/
**/.parcel-cache/
**/*.tsbuildinfo

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables — never commit real secrets
.env
.env.*
*.env
!.env.example
!**/.env.example

# Uploads / generated assets
uploads/
**/uploads/
public/uploads/
**/public/uploads/

# Cache / temporary files
.cache/
.tmp/
.temp/
.local/
pids/
*.pid

# Test and coverage artifacts
coverage/

# IDEs and editors
.vscode/
!.vscode/extensions.json
.idea/

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
