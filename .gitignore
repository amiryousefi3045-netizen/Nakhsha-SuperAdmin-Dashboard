# Root .gitignore for Nakhsha project

# Node.js
node_modules/

# Backend/frontend build outputs
dist/
build/
out/
/.vite/
/.parcel-cache/

# VCS
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.*

# IDEs
.vscode/
!.vscode/extensions.json
.idea/

# OS generated files
Desktop.ini

# Coverage
coverage/

# Uploads / user-generated files (do not commit uploads)
/uploads/

# Local runtime files
.cache/
.local/

# Ignore node_modules for subfolders explicitly (safe-guard)
frontend/node_modules/
backend/node_modules/

# Misc
.DS_Store
